{
  // Use IntelliSense para saber los atributos posibles.
  // Mantenga el puntero para ver las descripciones de los existentes atributos.
  // Para más información, visite: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Launch Google Chrome (light)",
      "configurations": ["Launch Google Chrome"]
    },
    {
      "name": "Launch Edge and attach DevTools",
      "configurations": ["Launch Microsoft Edge"]
    },
    {
      "name": "Launch Edge headless mode",
      "configurations": ["Launch Microsoft Edge in headless mode"]
    }
  ],
  "configurations": [
    {
      "type": "chrome",
      "name": "Launch Google Chrome",
      "request": "launch",
      "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--disable-extensions",
        "--disable-background-networking",
        "--disable-default-apps",
        "--disable-sync",
        "--no-first-run",
        "--no-default-browser-check",
        "--user-data-dir=${workspaceFolder}/.vscode/.vscode-chrome-profile",
        "--disable-session-crashed-bubble",
        "--auto-open-devtools-for-tabs",
        // "--disable-gpu",
        "--disable-renderer-backgrounding",
        "--disable-background-timer-throttling",
        "--disable-backgrounding-occluded-windows"
      ],
      "url": "http://localhost:4200",
      "presentation": {
        "hidden": true
      },
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "trace": true,
      "skipFiles": [
        "node_modules/**",
        "chrome://**",
        "chrome-error://**",
        "chrome-error://**",
        "**/zone.js",
        "**/polyfills.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "msedge",
      "name": "Launch Microsoft Edge",
      "request": "launch",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "--disable-extensions",
        "--disable-background-networking",
        "--disable-default-apps",
        "--disable-sync",
        "--no-first-run",
        "--no-default-browser-check",
        "--user-data-dir=${workspaceFolder}/.vscode/.vscode-edge-profile"
      ],
      "url": "http://localhost:4200",
      "presentation": {
        "hidden": true
      },
      "skipFiles": ["edge://**", "chrome://**", "chrome-error://**"],
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "msedge",
      "name": "Launch Microsoft Edge in headless mode",
      "request": "launch",
      "runtimeArgs": [
        "--headless",
        "--remote-debugging-port=9222",
        "--disable-extensions",
        "--disable-background-networking",
        "--disable-default-apps",
        "--disable-sync",
        "--no-first-run",
        "--no-default-browser-check",
        "--user-data-dir=${workspaceFolder}/.vscode/.vscode-edge-profile"
      ],
      "url": "http://localhost:4200",
      "presentation": {
        "hidden": true
      },
      "skipFiles": ["edge://**", "chrome://**", "chrome-error://**"],
      "trace": true,
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "vscode-edge-devtools.debug",
      "name": "Open Edge DevTools",
      "request": "attach",
      "url": "http://localhost:4200",
      "presentation": {
        "hidden": true
      }
    }
  ]
}
